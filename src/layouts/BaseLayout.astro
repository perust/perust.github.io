---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  robots?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  // OG/트위터 카드 이미지(루트 기준 경로). 없으면 /og/default.png 로 대체된다.
  image?: string;
  loadAnalytics?: boolean;
}

const {
  title = 'lentoludens · AI와 제품 실험을 기록하는 블로그',
  description = '아이디어를 제품으로 옮기는 과정을 기록하는 개인 포트폴리오와 블로그.',
  canonical = Astro.url.pathname,
  ogType = 'website',
  robots = 'index, follow',
  jsonLd,
  publishedTime,
  modifiedTime,
  tags = [],
  image = '/og/default.png',
  loadAnalytics = true,
} = Astro.props;
const site = Astro.site ?? new URL('https://perust.github.io');
const canonicalUrl = new URL(canonical, site).toString();
const ogImageUrl = new URL(image, site).toString();
const siteName = 'lentoludens';
// 검색 색인에서 제외한 태그·얇은 카테고리에는 광고 코드를 싣지 않는다.
// 탐색용 저가치 페이지를 AdSense 게재면으로 만들지 않기 위한 안전장치다.
const shouldLoadAdsense = !/\bnoindex\b/i.test(robots);
// JSON-LD를 단일 객체/배열 모두 허용하고, </script> 주입을 막기 위해 < 를 이스케이프한다.
const structuredData = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const serializeJsonLd = (data: Record<string, unknown>) =>
  JSON.stringify(data).replace(/</g, '\\u003c');
const navItems = [
  ['/', '홈'],
  ['/blog/', '블로그'],
  ['/wiki/', '위키'],
  ['/work/', '작업'],
  ['/portfolio/', '포트폴리오'],
  ['/about/', '소개'],
  ['/contact/', '문의'],
];
const isCurrent = (href: string) => href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(href);
---
<!doctype html>
<html lang="ko">
  <head>
    <!-- 모든 제3자 스크립트보다 먼저 현재 탭의 관리자 세션 여부를 한 번만 판정한다. -->
    <script is:inline>
      (() => {
        let hasAdminSession = true;
        try {
          hasAdminSession = Boolean(sessionStorage.getItem('lentoludens-comments-admin-token'));
        } catch (_) {
          // 저장소 상태를 확인할 수 없으면 제3자 추적기를 fail-closed로 억제한다.
        }
        document.documentElement.dataset.adminSession = String(hasAdminSession);
      })();
    </script>
    {shouldLoadAdsense && (
      <>
        <!-- Google AdSense: indexable publisher-content pages only -->
        <script is:inline>
          (() => {
            if (document.documentElement.dataset.adminSession === 'true') return;

            const adsense = document.createElement('script');
            adsense.async = true;
            adsense.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1573639772192057';
            adsense.crossOrigin = 'anonymous';
            document.head.append(adsense);
          })();
        </script>
      </>
    )}
    {loadAnalytics && (
      <>
        <!-- 관리자 세션에서는 비공개 댓글과 자격 증명을 보호하기 위해 제3자 추적기를 싣지 않는다. -->
        <script is:inline>
          (() => {
            if (document.documentElement.dataset.adminSession === 'true') return;

            window.dataLayer = window.dataLayer || [];
            function gtag(){window.dataLayer.push(arguments);}
            const googleTag = document.createElement('script');
            googleTag.async = true;
            googleTag.src = 'https://www.googletagmanager.com/gtag/js?id=G-HLB0E46BLH';
            document.head.append(googleTag);
            gtag('js', new Date());
            gtag('config', 'G-HLB0E46BLH');

            (function(c,l,a,r,i,t,y){
              c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
              t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i+"?ref=bwt";
              y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
            })(window, document, "clarity", "script", "xfwvbc1z9a");
          })();
        </script>
      </>
    )}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0f172a" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="lentoludens Blog RSS" href="/rss.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content={title} />
    {ogType === 'article' && (
      <>
        {publishedTime && <meta property="article:published_time" content={publishedTime} />}
        {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
        {tags.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+KR:wght@400;500;700;800&display=swap" rel="stylesheet" />
    {structuredData.map((data) => (
      <script type="application/ld+json" is:inline set:html={serializeJsonLd(data)} />
    ))}
    <slot name="head" />
  </head>
  <body>
    <header class="site-header" aria-label="사이트 헤더">
      <a class="brand" href="/" aria-label="홈으로 이동">
        <span class="brand-mark">L</span>
        <span>lentoludens</span>
      </a>
      <nav class="nav" aria-label="주요 메뉴">
        {navItems.map(([href, label]) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
      </nav>
    </header>
    <slot />
    <footer class="footer">
      <p>© 2026 lentoludens. Built with Astro on GitHub Pages.</p>
      <div class="footer-links">
        <a href="/privacy/">개인정보처리방침</a>
        <a href="/editorial-policy/">편집·운영 원칙</a>
        <a href="/about/">소개</a>
        <a href="/contact/">문의</a>
        <a href="/blog/">블로그</a>
      </div>
    </footer>
  </body>
</html>
