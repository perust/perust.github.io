---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
const commentsApiUrl = import.meta.env.PUBLIC_COMMENTS_API_URL || '';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---
<section class="comments" data-comments-root data-post-slug={slug} data-api-url={commentsApiUrl} data-turnstile-site-key={turnstileSiteKey}>
  <div class="comments-header">
    <div>
      <p class="section-kicker">Comments</p>
      <h2>댓글</h2>
    </div>
    <p class="comments-note">익명으로 바로 남길 수 있습니다. IP는 일부만 표시됩니다.</p>
  </div>

  <div class="comments-list" data-comments-list>
    <p class="comments-empty">댓글을 불러오는 중입니다.</p>
  </div>

  <div class="comments-owner-mode" data-comments-owner-mode hidden>
    <span>관리자 모드 · 비공개 댓글 원문 표시 중</span>
    <button type="button" data-comments-owner-logout>관리자 모드 종료</button>
  </div>

  <p class="comments-admin-entry">
    <span>운영자이신가요?</span>
    <a data-comments-admin-entry href="/admin/comments/" rel="nofollow">관리자 로그인</a>
  </p>

  <form class="comment-form" data-comment-form>
    <label>
      <span>닉네임</span>
      <input name="nickname" maxlength="40" placeholder="익명" autocomplete="nickname" />
    </label>
    <label>
      <span>댓글</span>
      <textarea name="body" maxlength="800" rows="4" placeholder="댓글을 입력해 주세요." required></textarea>
    </label>
    <label>
      <span>삭제 비밀번호</span>
      <input name="deletePassword" type="password" minlength="4" maxlength="80" placeholder="댓글 삭제에 사용할 비밀번호" autocomplete="new-password" required />
    </label>
    <label class="comment-private-option">
      <input name="isPrivate" type="checkbox" />
      <span>비공개 댓글로 남기기</span>
    </label>
    {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}
    <button type="submit">댓글 남기기</button>
    <p class="comment-form-message" data-comment-message></p>
  </form>
</section>

<script>
  const root = document.querySelector('[data-comments-root]');

  if (root) {
    const apiUrl = root.getAttribute('data-api-url') || '';
    const postSlug = root.getAttribute('data-post-slug') || '';
    const list = root.querySelector('[data-comments-list]');
    const form = root.querySelector('[data-comment-form]');
    const message = root.querySelector('[data-comment-message]');
    const ownerMode = root.querySelector('[data-comments-owner-mode]');
    const ownerLogout = root.querySelector('[data-comments-owner-logout]');
    const turnstileSiteKey = root.getAttribute('data-turnstile-site-key') || '';
    const adminTokenStorageKey = 'lentoludens-comments-admin-token';

    const readAdminToken = () => {
      try {
        return sessionStorage.getItem(adminTokenStorageKey)?.trim() || '';
      } catch (_) {
        return '';
      }
    };

    const clearAdminToken = () => {
      try {
        sessionStorage.removeItem(adminTokenStorageKey);
      } catch (_) {
        // 저장소 접근이 막힌 환경에서도 공개 댓글로 계속 동작한다.
      }
    };

    const setOwnerMode = (active) => {
      if (ownerMode) ownerMode.toggleAttribute('hidden', !active);
      if (form) form.toggleAttribute('hidden', active || !apiUrl);
    };

    const loadTurnstile = () => {
      if (!turnstileSiteKey || readAdminToken() || document.querySelector('[data-comments-turnstile-loader]')) return;
      const loader = document.createElement('script');
      loader.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
      loader.async = true;
      loader.defer = true;
      loader.dataset.commentsTurnstileLoader = 'true';
      document.head.append(loader);
    };

    const formatDate = (value) => {
      try {
        return new Date(value).toLocaleString('ko-KR', { dateStyle: 'medium', timeStyle: 'short' });
      } catch (_) {
        return value;
      }
    };

    const renderComments = (comments) => {
      if (!list) return;
      list.replaceChildren();
      if (!comments.length) {
        const empty = document.createElement('p');
        empty.className = 'comments-empty';
        empty.textContent = '아직 댓글이 없습니다.';
        list.append(empty);
        return;
      }

      for (const comment of comments) {
        const isRedacted = Boolean(comment.isPrivate && comment.isRedacted);
        const article = document.createElement('article');
        article.className = `comment-item${comment.isPrivate ? ' is-private' : ''}`;
        article.dataset.commentItem = 'true';
        article.dataset.privateRedacted = String(isRedacted);

        const meta = document.createElement('div');
        meta.className = 'comment-meta';
        const nickname = document.createElement('strong');
        nickname.textContent = String(comment.nickname || '익명');
        meta.append(nickname);
        if (comment.isPrivate) {
          const badge = document.createElement('span');
          badge.className = 'comment-private-badge';
          badge.textContent = '비공개';
          meta.append(badge);
        }
        if (comment.ipPrefix) {
          const ipPrefix = document.createElement('span');
          ipPrefix.textContent = String(comment.ipPrefix);
          meta.append(ipPrefix);
        }
        const time = document.createElement('time');
        time.textContent = String(formatDate(comment.createdAt));
        meta.append(time);

        const body = document.createElement('p');
        body.textContent = String(isRedacted ? '비공개 댓글입니다.' : (comment.body || ''));
        article.append(meta, body);

        if (!isRedacted) {
          const details = document.createElement('details');
          details.className = 'comment-delete';
          const summary = document.createElement('summary');
          summary.textContent = '삭제';
          const deleteForm = document.createElement('form');
          deleteForm.dataset.deleteForm = 'true';
          deleteForm.dataset.commentId = String(comment.id || '');
          const password = document.createElement('input');
          password.name = 'deletePassword';
          password.type = 'password';
          password.minLength = 4;
          password.maxLength = 80;
          password.placeholder = '삭제 비밀번호';
          password.required = true;
          const deleteButton = document.createElement('button');
          deleteButton.type = 'submit';
          deleteButton.textContent = '삭제하기';
          deleteForm.append(password, deleteButton);
          details.append(summary, deleteForm);
          article.append(details);
        }

        list.append(article);
      }
    };

    const loadComments = async () => {
      if (!apiUrl) {
        if (list) {
          list.replaceChildren();
          const empty = document.createElement('p');
          empty.className = 'comments-empty';
          empty.textContent = '댓글 API 설정이 아직 연결되지 않았습니다.';
          list.append(empty);
        }
        if (form) form.setAttribute('hidden', 'true');
        return;
      }
      try {
        let adminToken = readAdminToken();
        const fetchComments = (token) => fetch(`${apiUrl.replace(/\/$/, '')}/comments?slug=${encodeURIComponent(postSlug)}`, token ? {
          headers: { authorization: `Bearer ${token}` },
          cache: 'no-store',
          credentials: 'omit',
          referrerPolicy: 'no-referrer',
        } : { credentials: 'omit' });

        let response = await fetchComments(adminToken);
        if (response.status === 401 && adminToken) {
          clearAdminToken();
          adminToken = '';
          response = await fetchComments('');
        }
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || '댓글을 불러오지 못했습니다.');
        setOwnerMode(Boolean(adminToken));
        if (!adminToken) loadTurnstile();
        renderComments(data.comments || []);
      } catch (error) {
        if (list) {
          list.replaceChildren();
          const empty = document.createElement('p');
          empty.className = 'comments-empty';
          empty.textContent = '댓글을 불러오지 못했습니다.';
          list.append(empty);
        }
      }
    };

    ownerLogout?.addEventListener('click', () => {
      clearAdminToken();
      window.location.reload();
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!apiUrl) return;

      const formData = new FormData(form);
      const turnstileInput = form.querySelector('input[name="cf-turnstile-response"]');
      const payload = {
        postSlug,
        nickname: formData.get('nickname') || '익명',
        body: formData.get('body'),
        deletePassword: formData.get('deletePassword'),
        isPrivate: formData.get('isPrivate') === 'on',
        turnstileToken: turnstileInput?.value || '',
      };

      if (message) message.textContent = '댓글을 저장하는 중입니다.';
      const button = form.querySelector('button');
      button?.setAttribute('disabled', 'true');
      try {
        const response = await fetch(`${apiUrl.replace(/\/$/, '')}/comments`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || '댓글 저장에 실패했습니다.');
        form.reset();
        if (message) message.textContent = data.message || '댓글이 저장되었습니다.';
        if (window.turnstile) window.turnstile.reset();
        await loadComments();
      } catch (error) {
        if (message) message.textContent = error instanceof Error ? error.message : '댓글 저장에 실패했습니다.';
      } finally {
        button?.removeAttribute('disabled');
      }
    });

    list?.addEventListener('submit', async (event) => {
      const deleteForm = event.target?.closest?.('[data-delete-form]');
      if (!deleteForm || !apiUrl) return;
      event.preventDefault();

      const formData = new FormData(deleteForm);
      const button = deleteForm.querySelector('button');
      button?.setAttribute('disabled', 'true');
      if (message) message.textContent = '댓글을 삭제하는 중입니다.';

      try {
        const response = await fetch(`${apiUrl.replace(/\/$/, '')}/comments/delete`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            id: deleteForm.getAttribute('data-comment-id'),
            deletePassword: formData.get('deletePassword'),
          }),
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || '댓글 삭제에 실패했습니다.');
        if (message) message.textContent = data.message || '댓글을 삭제했습니다.';
        await loadComments();
      } catch (error) {
        if (message) message.textContent = error instanceof Error ? error.message : '댓글 삭제에 실패했습니다.';
      } finally {
        button?.removeAttribute('disabled');
      }
    });

    setOwnerMode(false);
    if (!readAdminToken()) loadTurnstile();
    loadComments();
  }
</script>
