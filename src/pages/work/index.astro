---
import BaseLayout from '../../layouts/BaseLayout.astro';

type WorkCategory = 'productivity' | 'data-ai' | 'game' | 'web-design' | 'learning';

type WorkItem = {
  type: string;
  category: WorkCategory;
  created: string;
  updated: string;
  title: string;
  desc: string;
  href?: string;
  status?: string;
  external?: boolean;
};

const categoryLabels: Record<WorkCategory, { label: string; desc: string }> = {
  productivity: { label: '생산성 도구', desc: '할 일, 회고, 개인 대시보드' },
  'data-ai': { label: '데이터 · AI', desc: '분석, 인식, 자동화 도구' },
  game: { label: '게임', desc: '규칙과 상호작용을 만든 웹 게임' },
  'web-design': { label: '웹 디자인', desc: '브랜드 페이지와 반응형 UI' },
  learning: { label: '학습 · 기록', desc: '연습 결과와 제작 기록' },
};

const workStack: WorkItem[] = [
  // created/updated는 작업물 자체의 개발 이력입니다. 블로그 등록·이전·브랜드/SEO 수정일은 포함하지 않습니다.
  { type: 'Lab', category: 'data-ai', created: '2026.08.11', updated: '2026.08.11', title: '냉장고 재료 인식 레시피 추천', desc: '냉장고 사진에서 재료 인식 · 보유 재료로 조리법 추천 · 알레르기 제외 · 저장과 메모', href: 'https://github.com/perust/fridge-recipe-nim', external: true, status: 'GitHub' },
  { type: 'Contents', category: 'game', created: '2026.08.04', updated: '2026.08.04', title: 'quiz by quiz', desc: '한국사 · 과학 · 지리 · 일반상식 · 예술과문화 4지선다 · 문항당 20초 · 즉시 해설', href: 'https://perust.github.io/quiz-by-quiz/', external: true, status: '바로 사용' },
  { type: 'Contents', category: 'productivity', created: '2026.08.04', updated: '2026.08.04', title: '할 일 관리 My What Todo', desc: '하위 할 일 · 우선순위 · 태그 · 검색 · 정렬 · JSON 내보내기', href: '/my-what-todo/', status: '바로 사용' },
  { type: 'Contents', category: 'productivity', created: '2026.08.16', updated: '2026.08.18', title: '쇼핑 리스트', desc: '체크 · 완료 항목 일괄 삭제 · JSON 파일 내보내기 · 백업 코드로 기기 간 이동', href: '/shopping-listapp/', status: '바로 사용' },
  { type: 'Contents', category: 'data-ai', created: '2026.02.16', updated: '2026.08.18', title: '감정 일기 마음 구슬', desc: '한 줄 일기의 감정 분석 · 공감 메시지 · 감정 구슬 보관 · 기억 이모티콘 · 코드로 기기 간 이동', href: 'https://ai-empathy-diary-sigma.vercel.app/', external: true, status: '바로 사용' },
  { type: 'Contents', category: 'data-ai', created: '2026.01.25', updated: '2026.07.27', title: '손글씨 숫자 인식기', desc: '그린 숫자를 브라우저에서 바로 인식하는 MNIST 기반 도구', href: '/contents/digit-recognizer/', status: '바로 사용' },
  { type: 'Portfolio', category: 'data-ai', created: '2026.07.09', updated: '2026.07.22', title: '데이터 복구 포트폴리오', desc: 'HDD · 서버 · NAS · 영상 · DB 복구와 자체 개발 도구 기록', href: '/portfolio/', status: '보기' },
  { type: 'Pre-public', category: 'productivity', created: '2026.06.28', updated: '2026.07.22', title: '회고/리뷰 노트 도구', desc: '관계와 생각을 정리하고 다음 계획으로 이어가는 회고 도구', status: '공개 전' },
  { type: 'Pre-public', category: 'data-ai', created: '2026.05.02', updated: '2026.07.31', title: 'SOXL Analyzer', desc: 'SOXL 매매를 데이터로 다시 확인하는 분석 프로그램', status: '공개 전' },
  { type: 'Lab', category: 'data-ai', created: '2026.06.28', updated: '2026.07.22', title: 'AI 업무 자동화 실험', desc: 'n8n과 AI 도구로 반복 작업을 줄이는 자동화 실험', status: '실험 중' },
  { type: 'Contents', category: 'productivity', created: '2026.07.09', updated: '2026.07.09', title: '나의 시작 페이지', desc: '시계 · 검색 · 날씨 · 뉴스 · 할 일 위젯을 모은 개인 대시보드', href: '/contents/start-page.html', status: '바로 사용' },
  { type: 'Lab', category: 'learning', created: '2026.06.28', updated: '2026.07.29', title: '제작 기록 블로그', desc: '만들어본 것과 막힌 것, 다시 쓸 내용을 남기는 제작 기록', href: '/blog/', status: '연결됨' },
  { type: 'Profile', category: 'learning', created: '2026.06.28', updated: '2026.06.28', title: 'GitHub 작업 허브', desc: '공개 저장소와 앞으로 공개할 작업물을 잇는 GitHub 프로필', href: 'https://github.com/perust', external: true, status: 'GitHub' },
  { type: 'Contents', category: 'game', created: '2022.11.01', updated: '2022.11.06', title: '끝말잇기 게임', desc: '순수 JavaScript로 만든 끝말잇기 게임 로직', href: '/contents/word-relay.html', status: 'Archive' },
  { type: 'Contents', category: 'learning', created: '2022.11.02', updated: '2022.11.06', title: '계산기', desc: '사칙연산 흐름을 구현한 JavaScript 연습', href: '/contents/calculator.html', status: 'Archive' },
  { type: 'Contents', category: 'game', created: '2022.11.07', updated: '2022.11.07', title: '숫자야구 게임', desc: '숫자 추리 규칙을 구현한 JavaScript 게임', href: '/contents/number-baseball.html', status: 'Archive' },
  { type: 'Homepage', category: 'web-design', created: '2022.08.28', updated: '2022.10.31', title: '플라워가든 페이지', desc: '이미지 중심으로 구성한 HTML/CSS 페이지', href: '/homepage/flower/index.html', status: 'Archive' },
  { type: 'Homepage', category: 'web-design', created: '2022.08.28', updated: '2022.10.31', title: '교보문고 모바일 리디자인', desc: '모바일 화면에 맞춘 서점 UI 리디자인', href: '/homepage/gyobo/index.html', status: 'Archive' },
  { type: 'Homepage', category: 'web-design', created: '2022.08.28', updated: '2022.10.31', title: '더페이스샵 모바일 리디자인', desc: '뷰티 브랜드의 모바일 UI 리디자인', href: '/homepage/thefaceshop/index.html', status: 'Archive' },
  { type: 'Homepage', category: 'web-design', created: '2022.08.28', updated: '2022.10.31', title: '뚜레쥬르 PC 리디자인', desc: '베이커리 브랜드의 PC 화면 리디자인', href: '/homepage/tous/index.html', status: 'Archive' },
  { type: 'Homepage', category: 'web-design', created: '2022.08.28', updated: '2022.10.31', title: '삼진어묵 메인', desc: '브랜드 사이트 메인 페이지 웹 퍼블리싱', href: '/homepage/3z/index.html', status: 'Archive' },
  { type: 'Homepage', category: 'web-design', created: '2022.08.28', updated: '2022.10.31', title: '삼진어묵 서브', desc: '브랜드 사이트 서브 페이지 웹 퍼블리싱', href: '/homepage/3z/sub.html', status: 'Archive' },
  { type: 'Study', category: 'learning', created: '2022.10.31', updated: '2022.11.07', title: '렛츠기릿 자바스크립트', desc: '자바스크립트 입문 강의 실습 모음', href: '/study/ZeroCho-JavaScript-Beginner/index.html', status: 'Archive' },
  { type: 'Study', category: 'web-design', created: '2022.09.11', updated: '2022.10.31', title: '반응형 웹 만들기', desc: '화면 크기에 맞춰 바뀌는 HTML/CSS 레이아웃 연습', href: '/study/responsive-web-design2017/index.html', status: 'Archive' },
];

workStack.sort((a, b) => b.created.localeCompare(a.created));

const categoryCounts = Object.fromEntries(
  Object.keys(categoryLabels).map((category) => [category, workStack.filter((item) => item.category === category).length]),
) as Record<WorkCategory, number>;

const latestUpdated = workStack.reduce((latest, item) => item.updated > latest ? item.updated : latest, '');
const categoryLatestUpdated = Object.fromEntries(
  Object.keys(categoryLabels).map((category) => [
    category,
    workStack.filter((item) => item.category === category).reduce((latest, item) => item.updated > latest ? item.updated : latest, ''),
  ]),
) as Record<WorkCategory, string>;

const itemTarget = (item: WorkItem) => item.external || item.href?.startsWith('/homepage') || item.href?.startsWith('/study') ? '_blank' : undefined;
const itemRel = (item: WorkItem) => itemTarget(item) ? 'noopener noreferrer' : undefined;
const site = Astro.site ?? new URL('https://perust.github.io');
const workDescription = '지금 제작하고 있는 작업물부터 이때까지 만들어온 작업물까지 모아두는 작업 아카이브.';
const workLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'lentoludens 작업',
  url: new URL('/work/', site).toString(),
  inLanguage: 'ko-KR',
  description: workDescription,
};
---
<BaseLayout title="lentoludens 작업 · 프로그램과 아카이브" description={workDescription} canonical="/work/" jsonLd={workLd}>
  <main id="top" class="work-page">
    <section class="hero section-shell work-hero" aria-labelledby="work-hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Work · Program · Archive</p>
        <h1 id="work-hero-title">제작한 작업물들</h1>
        <p class="hero-description">지금 쓰고 있는 도구부터 예전에 만든 게임과 웹 페이지까지, 실제 작업물을 중심으로 모았습니다.</p>
      </div>
    </section>

    <section id="stack" class="section-shell" aria-labelledby="stack-title">
      <div class="section-heading"><p class="section-kicker">Archive &amp; Lab</p><h2 id="stack-title">작업물 전체 보기</h2><p>종류를 골라 빠르게 찾거나, 전체 목록을 최근 작업순으로 볼 수 있습니다.</p></div>
      <nav class="work-categories" aria-label="작업물 종류 필터">
        <button class="work-category is-active" type="button" data-work-filter="all" aria-pressed="true">
          <span>전체</span><strong>{workStack.length}</strong><small>모든 작업물</small><time datetime={latestUpdated.replaceAll('.', '-')}>최근 업데이트 {latestUpdated}</time>
        </button>
        {(Object.entries(categoryLabels) as [WorkCategory, { label: string; desc: string }][]).map(([category, info]) => (
          <button class="work-category" type="button" data-work-filter={category} aria-pressed="false">
            <span>{info.label}</span><strong>{categoryCounts[category]}</strong><small>{info.desc}</small><time datetime={categoryLatestUpdated[category].replaceAll('.', '-')}>최근 업데이트 {categoryLatestUpdated[category]}</time>
          </button>
        ))}
      </nav>
      <p class="filter-result" aria-live="polite"><strong>{workStack.length}</strong>개의 작업물을 표시하고 있습니다.</p>
      <div class="stack-list">
        {workStack.map((item) => {
          const card = <>
            <div class="stack-marker" aria-hidden="true"></div>
            <div class="stack-card-header">
              <span class={`archive-tag ${item.type.toLowerCase().replace('pre-public', 'prepublic')}`}>{categoryLabels[item.category].label}</span>
              <span class="archive-date"><span>생성 {item.created}</span><span>업데이트 {item.updated}</span></span>
            </div>
            <h3 class="archive-title">{item.title}</h3>
            <p class="archive-desc">{item.desc}</p>
            <span class={`stack-status ${item.href ? 'is-linked' : 'is-muted'}`}>{item.href ? item.status ?? '보기' : item.status ?? '공개 전'}</span>
          </>;
          return item.href ? (
            <a class="stack-card" data-work-item data-category={item.category} href={item.href} target={itemTarget(item)} rel={itemRel(item)}>{card}</a>
          ) : (
            <article class="stack-card is-disabled" data-work-item data-category={item.category}>{card}</article>
          );
        })}
      </div>
    </section>

    <section id="contact" class="section-shell contact" aria-labelledby="contact-title">
      <div><p class="section-kicker">Contact</p><h2 id="contact-title">계속 만들고 있습니다.</h2><p>공개할 수 있는 코드는 GitHub에 올리고, 만들면서 배운 것은 블로그에 남기고 있습니다. 피드백이나 문의는 <a href="mailto:zyqn@naver.com">zyqn@naver.com</a>으로 보내주세요.</p></div>
      <div class="contact-actions">
        <a class="button secondary" href="https://github.com/perust" target="_blank" rel="noopener noreferrer">GitHub 열기</a>
        <a class="button primary" href="mailto:zyqn@naver.com">이메일 보내기</a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-work-filter]'));
  const workItems = Array.from(document.querySelectorAll<HTMLElement>('[data-work-item]'));
  const result = document.querySelector<HTMLElement>('.filter-result');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const selected = button.dataset.workFilter ?? 'all';
      let visibleCount = 0;

      filterButtons.forEach((candidate) => {
        const active = candidate === button;
        candidate.classList.toggle('is-active', active);
        candidate.setAttribute('aria-pressed', String(active));
      });

      workItems.forEach((item) => {
        const visible = selected === 'all' || item.dataset.category === selected;
        item.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      if (result) result.innerHTML = `<strong>${visibleCount}</strong>개의 작업물을 표시하고 있습니다.`;
    });
  });
</script>

<style>
  .work-hero {
    grid-template-columns: minmax(0, 760px);
    min-height: 0;
    padding-top: 5rem;
    padding-bottom: 4.25rem;
  }

  .work-hero .hero-description {
    max-width: 680px;
  }

  .work-categories {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0 0 1rem;
  }

  .work-category {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.18rem 0.75rem;
    min-width: 0;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 18px;
    color: var(--ink);
    text-align: left;
    background: rgba(255, 255, 255, 0.58);
    cursor: pointer;
    transition: 160ms ease;
  }

  .work-category:hover,
  .work-category:focus-visible,
  .work-category.is-active {
    border-color: rgba(37, 99, 235, 0.35);
    background: rgba(37, 99, 235, 0.08);
  }

  .work-category:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .work-category span {
    font-size: 0.9rem;
    font-weight: 800;
  }

  .work-category strong {
    grid-row: 1 / 4;
    grid-column: 2;
    align-self: center;
    color: var(--primary);
    font-size: 1.25rem;
  }

  .work-category small {
    overflow: hidden;
    color: var(--muted);
    font-size: 0.72rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .work-category time {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .filter-result {
    margin: 0 0 1rem 2.5rem;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .filter-result strong {
    color: var(--ink);
  }

  .stack-card[hidden] {
    display: none;
  }

  .archive-date {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.25rem 0.75rem;
    text-align: right;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: flex-end;
  }

  @media (max-width: 760px) {
    .work-hero {
      padding-top: 3rem;
      padding-bottom: 2.75rem;
    }

    .work-categories {
      grid-template-columns: 1fr;
    }

    .stack-card-header {
      align-items: flex-start;
    }

    .archive-date {
      display: grid;
      gap: 0.1rem;
      font-size: 0.7rem;
    }

    .contact-actions {
      display: grid;
      width: 100%;
    }
  }
</style>
