---
import BaseLayout from '../../layouts/BaseLayout.astro';

type WorkItem = {
  type: string;
  year: string;
  title: string;
  desc: string;
  href?: string;
  status?: string;
  external?: boolean;
};

const activeProjects = [
  {
    meta: ['Product', 'Pre-public'],
    title: '회고/리뷰 노트 도구',
    desc: '하루를 적는 데서 끝나지 않고, 나중에 내가 왜 그런 선택을 했는지 다시 볼 수 있는 도구를 만들고 있습니다. 아직은 공개 전입니다.',
    tags: ['React', 'Supabase', 'UX Writing'],
  },
  {
    meta: ['Data', 'Pre-public'],
    title: 'SOXL Analyzer',
    desc: 'SOXL 매매를 감으로만 보지 않으려고 만든 분석 도구입니다. 실제 계좌 흐름에 맞춰 계속 고치는 중이라 아직 공개 전입니다.',
    tags: ['Python', 'Streamlit', 'Decision support'],
  },
  {
    meta: ['Automation', 'Lab'],
    title: 'AI 업무 자동화 실험',
    desc: '반복되는 리서치, 정리, 배포 일을 줄이려고 n8n과 AI 도구를 이것저것 연결해보고 있습니다.',
    tags: ['n8n', 'AI agents', 'Ops'],
  },
];

const workStack: WorkItem[] = [
  {
    type: 'Pre-public',
    year: '2026',
    title: '회고/리뷰 노트 도구',
    desc: '하루 기록을 나중에 다시 꺼내볼 수 있게 만드는 도구입니다. 공개할 만한 버전이 되면 여기서 바로 연결해둘 예정입니다.',
    status: '공개 전',
  },
  {
    type: 'Pre-public',
    year: '2026',
    title: 'SOXL Analyzer',
    desc: 'SOXL 매매를 데이터로 다시 확인하려고 만든 분석 프로그램입니다. 지금은 비공개로 검증하고 있습니다.',
    status: '공개 전',
  },
  {
    type: 'Lab',
    year: '2026',
    title: '제작 기록 블로그',
    desc: '만들어본 것, 막힌 것, 다시 써먹을 만한 내용을 블로그에 남기고 있습니다.',
    href: '/blog/',
    status: '연결됨',
  },
  {
    type: 'Profile',
    year: '2026',
    title: 'GitHub 작업 허브',
    desc: '공개 저장소와 앞으로 열어둘 작업물을 이어서 볼 수 있는 GitHub 프로필입니다.',
    href: 'https://github.com/perust',
    external: true,
    status: 'GitHub',
  },
  {
    type: 'Contents',
    year: '2022',
    title: '끝말잇기 게임',
    desc: 'JavaScript 게임 로직 · 순수 JS 구현',
    href: '/contents/word-relay.html',
    status: 'Archive',
  },
  {
    type: 'Contents',
    year: '2022',
    title: '계산기',
    desc: 'JavaScript 연습 · 사칙연산 구현',
    href: '/contents/calculator.html',
    status: 'Archive',
  },
  {
    type: 'Contents',
    year: '2022',
    title: '숫자야구 게임',
    desc: 'JavaScript 연습 · 게임 로직 구현',
    href: '/contents/number-baseball.html',
    status: 'Archive',
  },
  {
    type: 'Homepage',
    year: '2022',
    title: '플라워가든 페이지',
    desc: 'HTML/CSS · 이미지 중심 레이아웃',
    href: '/homepage/flower/index.html',
    status: 'Archive',
  },
  {
    type: 'Homepage',
    year: '2022',
    title: '교보문고 모바일 리디자인',
    desc: '모바일 UI 실습 · 반응형 리디자인',
    href: '/homepage/gyobo/index.html',
    status: 'Archive',
  },
  {
    type: 'Homepage',
    year: '2022',
    title: '더페이스샵 모바일 리디자인',
    desc: '모바일 UI 실습 · 뷰티 브랜드 리디자인',
    href: '/homepage/thefaceshop/index.html',
    status: 'Archive',
  },
  {
    type: 'Homepage',
    year: '2022',
    title: '뚜레쥬르 PC 리디자인',
    desc: 'PC UI 실습 · 브랜드 사이트 리디자인',
    href: '/homepage/tous/index.html',
    status: 'Archive',
  },
  {
    type: 'Homepage',
    year: '2022',
    title: '삼진어묵 메인',
    desc: '웹 퍼블리싱 · 메인 페이지',
    href: '/homepage/3z/index.html',
    status: 'Archive',
  },
  {
    type: 'Homepage',
    year: '2022',
    title: '삼진어묵 서브',
    desc: '웹 퍼블리싱 · 서브 페이지',
    href: '/homepage/3z/sub.html',
    status: 'Archive',
  },
  {
    type: 'Study',
    year: '2022',
    title: '렛츠기릿 자바스크립트',
    desc: '자바스크립트 입문 · 강의 실습 모음',
    href: '/study/ZeroCho-JavaScript-Beginner/index.html',
    status: 'Archive',
  },
  {
    type: 'Study',
    year: '2022',
    title: '반응형 웹 만들기',
    desc: 'HTML/CSS 스터디 · 반응형 레이아웃',
    href: '/study/responsive-web-design2017/index.html',
    status: 'Archive',
  },
];

const itemTarget = (item: WorkItem) => item.external || item.href?.startsWith('/homepage') || item.href?.startsWith('/study') ? '_blank' : undefined;
const itemRel = (item: WorkItem) => itemTarget(item) ? 'noopener noreferrer' : undefined;
const site = Astro.site ?? new URL('https://perust.github.io');
const workDescription = '지금 만드는 프로그램, GitHub 작업물, 예전 웹 퍼블리싱 실습을 한곳에 모아둔 작업 아카이브.';
const workLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'lentoludens 작업',
  url: new URL('/work/', site).toString(),
  inLanguage: 'ko-KR',
  description: workDescription,
};
---
<BaseLayout title="lentoludens 작업 · 프로그램과 아카이브" description={workDescription} canonical="/work/" jsonLd={workLd}>
  <main id="top">
    <section class="hero section-shell" aria-labelledby="work-hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Work · Program · Archive</p>
        <h1 id="work-hero-title">지금 만드는 것부터<br />예전 작업까지 한곳에 모아둡니다.</h1>
        <p class="hero-description">아직 공개하지 못한 작업물이 많습니다. 공개할 수 있는 프로그램, 제작 기록, 예전 실습물부터 <strong>Archive &amp; Lab</strong>에 하나씩 올려두려고 합니다.</p>
        <div class="hero-actions">
          <a class="button primary" href="#stack">작업물 전체 보기</a>
          <a class="button secondary" href="#projects">공개 전 작업 보기</a>
          <a class="button secondary" href="https://github.com/perust" target="_blank" rel="noopener noreferrer">GitHub 열기</a>
        </div>
      </div>
      <aside class="hero-card" aria-label="작업 허브 요약">
        <div class="status-pill"><span></span> 공개 전 작업 정리 중</div>
        <dl class="profile-list">
          <div><dt>방향</dt><dd>아이디어를 실제로 써볼 수 있게 만들기</dd></div>
          <div><dt>현재</dt><dd>주요 작업물은 공개 준비 중</dd></div>
          <div><dt>스택</dt><dd>React · Python · Supabase · Astro · AI-assisted build</dd></div>
        </dl>
      </aside>
    </section>

    <section id="focus" class="section-shell split-section" aria-labelledby="focus-title">
      <div><p class="section-kicker">Current focus</p><h2 id="focus-title">요즘 신경 쓰는 것</h2></div>
      <div class="focus-grid">
        <article class="focus-card"><span class="card-index">01</span><h3>소개에서 작업으로 이어지게</h3><p>홈페이지가 소개로만 끝나지 않고, 제가 실제로 만들고 있는 것들까지 이어졌으면 합니다.</p></article>
        <article class="focus-card"><span class="card-index">02</span><h3>아직 못 보여줘도<br />자리는 남겨두기</h3><p>아직 보여주기 어려운 작업도 있지만, 나중에 올려둘 자리는 미리 만들어두려고 합니다.</p></article>
        <article class="focus-card"><span class="card-index">03</span><h3>작업의 흐름 남겨두기</h3><p>예전 실습부터 지금 만드는 것까지 이어서 남겨두면, 시간이 지나도 전체 흐름이 보일 것 같습니다.</p></article>
      </div>
    </section>

    <section id="projects" class="section-shell" aria-labelledby="projects-title">
      <div class="section-heading"><p class="section-kicker">Pre-public programs</p><h2 id="projects-title">지금 만들고 있는 것들</h2><p>요즘 만들고 있는 것들은 아직 공개 전입니다. 공개해도 괜찮겠다 싶을 때, 여기에서 바로 볼 수 있게 연결해두려고 합니다.</p></div>
      <div class="project-grid">
        {activeProjects.map((project, index) => (
          <article class={`project-card ${index === 0 ? 'featured' : ''}`}>
            <div class="project-meta">{project.meta.map((meta) => <span>{meta}</span>)}</div>
            <h3>{project.title}</h3>
            <p>{project.desc}</p>
            <ul class="tag-list" aria-label="사용 기술 및 키워드">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
          </article>
        ))}
      </div>
    </section>

    <section id="stack" class="section-shell" aria-labelledby="stack-title">
      <div class="section-heading"><p class="section-kicker">Archive &amp; lab</p><h2 id="stack-title">작업물 전체 보기</h2><p>새로 만든 것은 위에 올리고, 예전에 만들었던 웹 퍼블리싱·자바스크립트 실습은 아래에 그대로 남겨둡니다. 공개 전 작업은 공개 전이라고 표시해두었습니다.</p></div>
      <div class="stack-list">
        {workStack.map((item) => {
          const card = <>
            <div class="stack-marker" aria-hidden="true"></div>
            <div class="stack-card-header">
              <span class={`archive-tag ${item.type.toLowerCase().replace('pre-public', 'prepublic')}`}>{item.type}</span>
              <span class="archive-date">{item.year}</span>
            </div>
            <h3 class="archive-title">{item.title}</h3>
            <p class="archive-desc">{item.desc}</p>
            <span class={`stack-status ${item.href ? 'is-linked' : 'is-muted'}`}>{item.href ? item.status ?? '보기' : item.status ?? '공개 전'}</span>
          </>;
          return item.href ? (
            <a class="stack-card" href={item.href} target={itemTarget(item)} rel={itemRel(item)}>{card}</a>
          ) : (
            <article class="stack-card is-disabled">{card}</article>
          );
        })}
      </div>
    </section>

    <section id="principles" class="section-shell principles" aria-labelledby="principles-title">
      <div class="section-heading compact"><p class="section-kicker">Notes</p><h2 id="principles-title">작업할 때 자주 생각하는 것</h2></div>
      <ol class="principle-list"><li><strong>일단 작게 만들기</strong><span>머릿속에만 두면 계속 흐려져서, 작은 화면이라도 먼저 만들어보려고 합니다.</span></li><li><strong>직접 써보면서 고치기</strong><span>처음부터 완벽하게 잡기보다 실제로 써보면서 부족한 부분을 찾는 편입니다.</span></li><li><strong>반복되는 일은 줄이기</strong><span>계속 반복하는 일은 자동화하거나 도구로 빼두려고 합니다.</span></li><li><strong>기록 남겨두기</strong><span>나중에 다시 봤을 때 왜 그렇게 만들었는지 알 수 있게 남겨두는 편이 좋습니다.</span></li></ol>
    </section>

    <section id="contact" class="section-shell contact" aria-labelledby="contact-title">
      <div><p class="section-kicker">Contact</p><h2 id="contact-title">계속 만들고 있습니다.</h2><p>공개할 수 있는 코드는 GitHub에 올리고, 만들면서 배운 것은 블로그에 남기고 있습니다. 피드백이나 문의는 <a href="mailto:zyqn@naver.com">zyqn@naver.com</a>으로 보내주세요.</p></div>
      <a class="button primary" href="mailto:zyqn@naver.com">이메일 보내기</a>
    </section>
  </main>
</BaseLayout>
