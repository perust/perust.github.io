---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import { categoryPath, tagPath, ogImageForPost, getAllPosts, getRelatedPosts, getPrevNext } from '../../utils/blog';
import { isIndexableTag, slugify } from '../../config/taxonomy';

export async function getStaticPaths() {
  const modules = import.meta.glob('../../content/blog/*.md', { eager: true });
  return Object.entries(modules).map(([path, post]: [string, any]) => {
    const slug = path.split('/').pop()?.replace('.md', '') || '';
    return {
      params: { slug },
      props: { post, slug },
    };
  });
}

const { post, slug } = Astro.props;
const { Content } = post;
const { title, description, date, updated, category, tags = [], image, faqs = [] } = post.frontmatter;
const commentsEnabled = Boolean(import.meta.env.PUBLIC_COMMENTS_API_URL);

const site = Astro.site ?? new URL('https://perust.github.io');
const pageUrl = new URL(Astro.url.pathname, site).toString();
const publishedISO = new Date(date).toISOString();
const modifiedISO = updated ? new Date(updated).toISOString() : publishedISO;

// 글 OG 이미지: frontmatter image > public/og/posts/<slug>.png(있을 때) > 카테고리 기본.
// 빌드 시 글별 이미지가 실제로 있는지 확인해, 아직 생성 안 된 새 글에서도 깨지지 않게 한다.
// (astro build의 cwd는 프로젝트 루트다.)
const postImageExists = existsSync(join(process.cwd(), 'public', 'og', 'posts', `${slug}.png`));
const ogImage = ogImageForPost({ image, category, slug }, postImageExists);
const ogImageUrl = new URL(ogImage, site).toString();
const categoryUrl = new URL(categoryPath(category), site).toString();

// 본문 아래에 보여줄 관련 글과 이전/다음 글. 최신순 목록을 공유 헬퍼로 가져온다.
const allPosts = getAllPosts();
const currentPost = allPosts.find((post) => post.slug === slug);
const relatedPosts = currentPost ? getRelatedPosts(currentPost, allPosts) : [];
const { prev, next } = getPrevNext(slug, allPosts);
const formatDate = (value: string | Date) => new Date(value).toLocaleDateString('ko-KR');

// 사이드바 태그는 색인 판정 SSOT(isIndexableTag)를 통과한 태그만 링크하고,
// 나머지는 텍스트로만 보여준다 — noindex 태그 페이지로 가는 내부 링크를 만들지 않는다.
const tagCountBySlug = new Map<string, number>();
for (const p of allPosts) {
  for (const t of p.tags ?? []) {
    const key = slugify(t);
    tagCountBySlug.set(key, (tagCountBySlug.get(key) ?? 0) + 1);
  }
}
const isLinkableTag = (tag: string) => isIndexableTag(tag, tagCountBySlug.get(slugify(tag)) ?? 0);

const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  inLanguage: 'ko-KR',
  datePublished: publishedISO,
  dateModified: modifiedISO,
  url: pageUrl,
  image: ogImageUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  author: { '@type': 'Person', name: 'lentoludens', url: site.toString() },
  publisher: {
    '@type': 'Organization',
    name: 'lentoludens',
    url: site.toString(),
    logo: {
      '@type': 'ImageObject',
      url: new URL('/icon-512.png', site).toString(),
      width: 512,
      height: 512,
    },
  },
  articleSection: category,
  ...(tags.length ? { keywords: tags.join(', ') } : {}),
};

// Home > Blog > category > post 순서의 BreadcrumbList.
// 카테고리는 전용 정적 페이지(/blog/category/<slug>/)를 가리킨다.
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: site.toString() },
    { '@type': 'ListItem', position: 2, name: '블로그', item: new URL('/blog/', site).toString() },
    { '@type': 'ListItem', position: 3, name: category, item: categoryUrl },
    { '@type': 'ListItem', position: 4, name: title, item: pageUrl },
  ],
};

const faqLd = faqs.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
} : undefined;

const jsonLd = faqLd ? [blogPostingLd, breadcrumbLd, faqLd] : [blogPostingLd, breadcrumbLd];
---
<BaseLayout title={`${title} · lentoludens 블로그`} description={description} canonical={Astro.url.pathname} ogType="article" jsonLd={jsonLd} publishedTime={publishedISO} modifiedTime={modifiedISO} tags={tags} image={ogImage}>
  <main class="post-layout">
    <header class="post-header">
      <nav class="post-header-nav" aria-label="글 탐색">
        <a href={categoryPath(category)}>{category}</a>
        <a href="/blog/">전체 글</a>
      </nav>
      <div class="post-kicker">
        <p class="section-kicker"><a href={categoryPath(category)}>{category}</a></p>
      </div>
      <h1 id="post-title">{title}</h1>
      <p class="post-header-meta post-byline">
        <time datetime={publishedISO}>{formatDate(date)}</time>
        {updated && <span>· 수정 <time datetime={modifiedISO}>{formatDate(updated)}</time></span>}
        <span>· 글쓴이 <a href="/about/">lentoludens</a></span>
      </p>
    </header>
    <article class="post-article" aria-labelledby="post-title">
      <Content />

      {relatedPosts.length > 0 && (
        <section class="post-related" aria-label="관련 글">
          <h2 class="post-related-title">관련 글</h2>
          <ul class="related-grid">
            {relatedPosts.map((related) => (
              <li>
                <a class="related-card" href={`/blog/${related.slug}/`} aria-label={`관련 글: ${related.title}`}>
                  <span class="related-category">{related.category}</span>
                  <time datetime={new Date(related.date).toISOString()}>{formatDate(related.date)}</time>
                  <h3>{related.title}</h3>
                  <p>{related.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {(prev || next) && (
        <nav class="post-pager" aria-label="이전 다음 글 이동">
          {prev ? (
            <a class="post-pager-link is-prev" href={`/blog/${prev.slug}/`} rel="prev" aria-label={`이전 글: ${prev.title}`}>
              <span class="post-pager-dir">← 이전 글</span>
              <span class="post-pager-title">{prev.title}</span>
            </a>
          ) : <span class="post-pager-spacer" aria-hidden="true"></span>}
          {next ? (
            <a class="post-pager-link is-next" href={`/blog/${next.slug}/`} rel="next" aria-label={`다음 글: ${next.title}`}>
              <span class="post-pager-dir">다음 글 →</span>
              <span class="post-pager-title">{next.title}</span>
            </a>
          ) : <span class="post-pager-spacer" aria-hidden="true"></span>}
        </nav>
      )}

      {commentsEnabled && <Comments slug={slug} />}
    </article>
    <aside class="sidebar-card" aria-label="블로그 안내">
      <div class="sidebar-intro">
        <h2>lentoludens</h2>
        <p class="sidebar-intro-title">렌토루덴스 블로그</p>
        <p>직접 공부하거나 찾아본 정보, 책, 다녀온 장소 등에 대한 글을 적습니다.</p>
        <p>따로 문의주실 분은 메일로 부탁드립니다.</p>
        <a class="sidebar-email" href="mailto:zyqn@naver.com">email: zyqn@naver.com</a>
      </div>
      <ul class="tag-cloud">{tags.map((tag: string) => <li>{isLinkableTag(tag) ? <a href={tagPath(tag)}>#{tag}</a> : <span>#{tag}</span>}</li>)}</ul>
    </aside>
  </main>

  <dialog id="image-lightbox" class="image-lightbox" data-image-lightbox data-lightbox-fit="true" aria-labelledby="image-lightbox-caption">
    <p id="image-lightbox-caption" class="image-lightbox__caption" data-lightbox-caption>이미지 확대 보기</p>
    <div class="image-lightbox__viewport" data-lightbox-viewport>
      <div class="image-lightbox__canvas">
        <div class="image-lightbox__frame">
          <img class="image-lightbox__image" data-lightbox-image alt="" />
          <button class="image-lightbox__size-toggle" type="button" data-lightbox-size-toggle aria-label="원본 크기로 보기">
            <span data-lightbox-size-icon aria-hidden="true">+</span>
          </button>
        </div>
      </div>
    </div>
    <button class="image-lightbox__close" type="button" data-lightbox-close aria-label="확대 이미지 닫기">
      <span aria-hidden="true">×</span>
    </button>
  </dialog>
</BaseLayout>

<script>
  import { initializeImageLightbox } from '../../utils/image-lightbox.mjs';

  const initializeImageCarousels = () => {
    document.querySelectorAll('[data-image-carousel]').forEach((carousel) => {
      if (carousel.dataset.carouselReady === 'true') return;

      const track = carousel.querySelector('.image-carousel-track');
      const items = Array.from(track?.querySelectorAll('img') ?? []);
      const previous = carousel.querySelector('[data-carousel-prev]');
      const next = carousel.querySelector('[data-carousel-next]');
      const status = carousel.querySelector('[data-carousel-status]');
      if (!track || !previous || !next || !status || items.length === 0) return;

      carousel.dataset.carouselReady = 'true';

      const currentIndex = () => {
        const scrollLeft = track.scrollLeft;
        return items.reduce((closest, item, index) => {
          const currentDistance = Math.abs(items[closest].offsetLeft - scrollLeft);
          const itemDistance = Math.abs(item.offsetLeft - scrollLeft);
          return itemDistance < currentDistance ? index : closest;
        }, 0);
      };

      const update = () => {
        const index = currentIndex();
        const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);
        previous.disabled = track.scrollLeft <= 4;
        next.disabled = track.scrollLeft >= maxScroll - 4;
        status.textContent = `사진 ${index + 1} / ${items.length}`;
      };

      const move = (delta) => {
        const targetIndex = Math.max(0, Math.min(items.length - 1, currentIndex() + delta));
        const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
        track.scrollTo({ left: items[targetIndex].offsetLeft, behavior });
      };

      previous.addEventListener('click', () => move(-1));
      next.addEventListener('click', () => move(1));
      track.addEventListener('scroll', update, { passive: true });
      track.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        move(event.key === 'ArrowLeft' ? -1 : 1);
      });
      window.addEventListener('resize', update, { passive: true });
      items.forEach((item) => item.addEventListener('load', update, { once: true }));
      update();
    });
  };

  const initializePostImages = () => {
    initializeImageCarousels();
    initializeImageLightbox();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializePostImages, { once: true });
  } else {
    initializePostImages();
  }
</script>

<style is:global>
  .post-article .app-launch-button {
    display: inline-flex;
    width: min(100%, 28rem);
    min-height: 3.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0.6rem 0 1.2rem;
    padding: 0.9rem 1rem;
    border: 1px solid rgba(37, 99, 235, 0.28);
    border-radius: 0.9rem;
    background: linear-gradient(135deg, #ffffff 0%, #eff6ff 100%);
    box-shadow: 0 0.45rem 1.1rem rgba(37, 99, 235, 0.1);
    color: #0f172a;
    text-decoration: none;
    transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }

  .post-article .app-launch-button:hover {
    transform: translateY(-1px);
    border-color: #2563eb;
    box-shadow: 0 0.7rem 1.4rem rgba(37, 99, 235, 0.17);
  }

  .post-article .app-launch-button:focus-visible {
    outline: 3px solid rgba(37, 99, 235, 0.35);
    outline-offset: 3px;
  }

  .post-article .app-launch-button__label {
    font-weight: 800;
  }

  .post-article .app-launch-button__action {
    flex: 0 0 auto;
    color: #2563eb;
    font-size: 0.88rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .post-article .image-carousel {
    margin: 1.1rem 0 1.6rem;
  }

  .post-article .image-carousel-track {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    overflow-x: auto;
    padding: 0.4rem 0 0.8rem;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    overscroll-behavior-inline: contain;
  }

  .post-article .image-carousel-track img {
    display: block;
    flex: 0 0 auto;
    width: auto;
    max-width: min(82vw, 620px);
    height: auto;
    max-height: 390px;
    object-fit: contain;
    scroll-snap-align: start;
    margin: 0;
  }

  .post-article .image-carousel-track--contained-slides img {
    width: min(82vw, 620px);
    height: 390px;
    background: #ffffff;
  }

  .post-article .image-carousel-controls {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.2rem;
  }

  .post-article .image-carousel-controls button {
    min-height: 2.6rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid rgba(37, 99, 235, 0.24);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    color: #1d4ed8;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: background 160ms ease, border-color 160ms ease, opacity 160ms ease;
  }

  .post-article .image-carousel-controls button:first-child {
    justify-self: start;
  }

  .post-article .image-carousel-controls button:last-child {
    justify-self: end;
  }

  .post-article .image-carousel-controls button:hover:not(:disabled),
  .post-article .image-carousel-controls button:focus-visible {
    border-color: #2563eb;
    background: #eff6ff;
  }

  .post-article .image-carousel-controls button:disabled {
    opacity: 0.38;
    cursor: default;
  }

  .post-article .image-carousel-status {
    min-width: 5.8rem;
    color: #64748b;
    font-size: 0.9rem;
    font-weight: 700;
    text-align: center;
  }

  html {
    scrollbar-gutter: stable;
  }

  html.image-lightbox-open {
    overflow: hidden;
    background: #020617;
  }

  .post-article img[data-lightbox-ready="true"] {
    cursor: zoom-in;
  }

  .post-article img[data-lightbox-ready="true"]:focus-visible {
    outline: 3px solid rgba(37, 99, 235, 0.55);
    outline-offset: 4px;
  }

  .image-lightbox {
    position: fixed;
    inset: 0;
    width: min(96vw, 110rem);
    height: 94dvh;
    max-width: none;
    max-height: none;
    margin: auto;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 1rem;
    overflow: hidden;
    background: #0b1120;
    box-shadow: 0 1.5rem 4rem rgba(2, 6, 23, 0.55);
    color: #f8fafc;
  }

  .image-lightbox[open] {
    display: block;
  }

  .image-lightbox::backdrop {
    background: rgba(2, 6, 23, 0.84);
    backdrop-filter: blur(4px);
  }

  .image-lightbox__caption {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .image-lightbox__viewport {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
    background: #020617;
    touch-action: pan-x pan-y pinch-zoom;
  }

  .image-lightbox__canvas {
    display: grid;
    width: max-content;
    height: max-content;
    min-width: 100%;
    min-height: 100%;
    place-items: center;
    box-sizing: border-box;
    padding: 1rem;
  }

  .image-lightbox__frame {
    position: relative;
    display: grid;
    width: max-content;
    height: max-content;
  }

  .image-lightbox__image {
    grid-area: 1 / 1;
    display: block;
    width: auto;
    height: auto;
    max-width: none;
    max-height: none;
    margin: 0;
    background: #ffffff;
    box-shadow: 0 0.75rem 2rem rgba(0, 0, 0, 0.38);
  }

  .image-lightbox[data-lightbox-fit="true"] .image-lightbox__canvas {
    width: 100%;
    height: 100%;
  }

  .image-lightbox[data-lightbox-fit="true"] .image-lightbox__image {
    max-width: 100%;
    max-height: 100%;
  }

  .image-lightbox__size-toggle,
  .image-lightbox__close {
    z-index: 3;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.42);
    border-radius: 999px;
    box-shadow: 0 0.35rem 1rem rgba(2, 6, 23, 0.34);
    color: #ffffff;
    font: inherit;
    line-height: 1;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: background 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .image-lightbox__size-toggle {
    position: sticky;
    grid-area: 1 / 1;
    top: 1rem;
    left: 1rem;
    align-self: start;
    justify-self: start;
    margin: 1rem;
    background: rgba(15, 23, 42, 0.58);
    font-size: 1.75rem;
    font-weight: 500;
  }

  .image-lightbox__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(15, 23, 42, 0.58);
    font-size: 1.45rem;
    font-weight: 400;
  }

  .image-lightbox__size-toggle:hover,
  .image-lightbox__close:hover,
  .image-lightbox__size-toggle:focus-visible,
  .image-lightbox__close:focus-visible {
    border-color: rgba(255, 255, 255, 0.82);
    background: rgba(15, 23, 42, 0.82);
    outline: 3px solid rgba(147, 197, 253, 0.72);
    outline-offset: 2px;
    transform: scale(1.04);
  }

  @media (max-width: 640px) {
    .post-article .app-launch-button {
      width: 100%;
      padding: 0.85rem 0.9rem;
    }

    .post-article .image-carousel-track img {
      max-width: 82vw;
      max-height: 320px;
    }

    .post-article .image-carousel-controls {
      gap: 0.45rem;
    }

    .post-article .image-carousel-controls button {
      min-height: 2.5rem;
      padding: 0.5rem 0.75rem;
      font-size: 0.9rem;
    }

    .image-lightbox {
      width: 100vw;
      height: 100dvh;
      border: 0;
      border-radius: 0;
    }

    .image-lightbox__size-toggle,
    .image-lightbox__close {
      width: 2.6rem;
      height: 2.6rem;
    }
  }
</style>
