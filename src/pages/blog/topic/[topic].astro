---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllPosts, categoryPath, ogImageForCategory } from '../../../utils/blog';
import { TOPIC_HUBS, canonicalCategoryFor } from '../../../config/taxonomy';

// 에디터가 하위 주제별 대표 글을 직접 고른 주제 허브(topic hub) 페이지.
// 새 글을 만들지 않고, 큐레이션된 슬러그 기준으로만 보여준다(글의 카테고리와 무관).
// hub.categories 는 대표 카테고리로, 전체 글 수 안내와 카테고리 아카이브 CTA 에만 쓴다.
// 카테고리 전체 글 목록은 여기 나열하지 않고 카테고리 아카이브로 가는 CTA 링크로만 연결한다.
export function getStaticPaths() {
  const posts = getAllPosts();
  return TOPIC_HUBS.map((hub) => {
    const hubPosts = posts.filter((post) => hub.categories.includes(canonicalCategoryFor(post.category)));
    const bySlug = new Map(posts.map((post) => [post.slug, post]));
    // 같은 글이 여러 하위 주제에 큐레이션되어도 페이지에는 한 번만 나온다.
    const seen = new Set();
    const subtopics = hub.subtopics.map((subtopic) => ({
      ...subtopic,
      posts: subtopic.slugs
        .map((slug) => bySlug.get(slug))
        .filter((post) => {
          if (!post || seen.has(post.slug)) return false;
          seen.add(post.slug);
          return true;
        }),
    }));
    const curatedPosts = subtopics.flatMap((subtopic) => subtopic.posts);
    return {
      params: { topic: hub.slug },
      props: { hub, curatedPosts, subtopics, totalPostCount: hubPosts.length },
    };
  });
}

const { hub, curatedPosts, subtopics, totalPostCount } = Astro.props;
const site = Astro.site ?? new URL('https://perust.github.io');
const path = `/blog/topic/${hub.slug}/`;
const pageUrl = new URL(path, site).toString();
const title = `${hub.title} 주제 허브 · lentoludens 블로그`;
const description = hub.description;
const primaryCategory = hub.categories[0];

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${hub.title} · lentoludens 블로그`,
  description,
  url: pageUrl,
  inLanguage: 'ko-KR',
  isPartOf: { '@type': 'Blog', name: 'lentoludens 블로그', url: new URL('/blog/', site).toString() },
  // ItemList 는 이 페이지에 실제로 나열된 큐레이션 글만 담는다(카테고리 전체 글 아님).
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: curatedPosts.length,
    itemListElement: curatedPosts.map((post: any, index: number) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(`/blog/${post.slug}/`, site).toString(),
      name: post.title,
    })),
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: site.toString() },
    { '@type': 'ListItem', position: 2, name: '블로그', item: new URL('/blog/', site).toString() },
    { '@type': 'ListItem', position: 3, name: hub.title, item: pageUrl },
  ],
};
---
<BaseLayout title={title} description={description} canonical={path} robots="index, follow" jsonLd={[collectionLd, breadcrumbLd]} image={ogImageForCategory(primaryCategory)}>
  <main>
    <section class="section-shell blog-hero blog-hero-compact">
      <p class="section-kicker"><a href="/blog/">블로그</a> · 주제 허브</p>
      <h1>{hub.title}</h1>
      <p class="hero-description">{hub.description}</p>
      <p class="hero-description"><a class="text-link" href={categoryPath(primaryCategory)}>{primaryCategory} 카테고리 전체 글 최신순으로 보기 →</a></p>
    </section>

    <section class="section-shell hub-subtopics" aria-label={`${hub.title} 하위 주제`} style="padding-top:0">
      {subtopics.map((subtopic: any) => subtopic.posts.length > 0 && (
        <div class="hub-subtopic">
          <h2>{subtopic.label}</h2>
          <p>{subtopic.description}</p>
          <ul class="hub-subtopic-list">
            {subtopic.posts.map((post: any) => (
              <li><a href={`/blog/${post.slug}/`}>{post.title}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="section-shell" aria-label={`${hub.title} 전체 글 안내`}>
      <div class="section-heading">
        <p class="section-kicker">All posts</p>
        <h2>{hub.title} 전체 글 보기</h2>
        <p>위 목록은 하위 주제별 대표 글만 고른 것입니다. {primaryCategory} 카테고리의 전체 글 {totalPostCount}편은 아카이브에서 최신순으로 볼 수 있습니다.</p>
      </div>
      <p><a class="button secondary" href={categoryPath(primaryCategory)}>{primaryCategory} 전체 글 {totalPostCount}편 보기 →</a></p>
      <p style="margin-top:1.5rem"><a class="text-link" href="/blog/">← 블로그 전체 글 보기</a></p>
    </section>
  </main>
</BaseLayout>
