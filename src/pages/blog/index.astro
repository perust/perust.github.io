---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryPath, tagPath } from '../../utils/blog';
import { TOPIC_HUBS } from '../../config/taxonomy';

const modules = import.meta.glob('../../content/blog/*.md', { eager: true });
const posts = Object.entries(modules)
  .map(([path, post]: [string, any]) => ({
    slug: path.split('/').pop()?.replace('.md', ''),
    ...post.frontmatter,
  }))
  .sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf());

// 첫 화면에는 최신 글 일부만 보여주고, 나머지는 카테고리 탐색으로 안내한다.
const LIST_LIMIT = 20;
const featuredPost = posts[0];
const restPosts = posts.slice(1, LIST_LIMIT);
const categories = Array.from(new Set(posts.map((post) => post.category))).sort();
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.tags ?? []) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const popularTags = Array.from(tagCounts.entries())
  .sort(([tagA, countA], [tagB, countB]) => countB - countA || tagA.localeCompare(tagB, 'ko'))
  .slice(0, 15)
  .map(([tag]) => tag);

const site = Astro.site ?? new URL('https://perust.github.io');
const blogDescription = '프로젝트 제작기, AI 자동화, 투자 데이터, 회고 시스템을 다루는 개인 블로그.';
const blogLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'lentoludens 블로그',
  description: blogDescription,
  url: new URL('/blog/', site).toString(),
  inLanguage: 'ko-KR',
  publisher: { '@type': 'Organization', name: 'lentoludens', url: site.toString() },
  blogPost: posts.slice(0, LIST_LIMIT).map((post) => ({
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.description,
    datePublished: new Date(post.date).toISOString(),
    url: new URL(`/blog/${post.slug}/`, site).toString(),
  })),
};
---
<BaseLayout title="lentoludens 블로그 · AI, 자동화, 투자 데이터 기록" description={blogDescription} jsonLd={blogLd}>
  <main>
    <section class="section-shell blog-hero blog-hero-compact">
      <p class="section-kicker">Blog</p>
      <h1>블로그</h1>
      <p class="hero-description">프로젝트 제작기, AI 자동화, 투자 데이터, 회고 시스템을 글로 정리합니다.</p>
    </section>

    <section class="section-shell" aria-labelledby="topic-hubs-title" style="padding-top:0">
      <div class="section-heading">
        <p class="section-kicker">Topic hubs</p>
        <h2 id="topic-hubs-title">주제로 보기</h2>
        <p>비중이 큰 주제 3개는 하위 주제와 대표 글을 큐레이션한 허브 페이지로 따로 정리했습니다.</p>
      </div>
      <ul class="hub-nav-grid">
        {TOPIC_HUBS.map((hub) => (
          <li>
            <a class="hub-nav-card" href={`/blog/topic/${hub.slug}/`}>
              <h3>{hub.title}</h3>
              <p>{hub.tagline}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="section-shell blog-page" aria-label="블로그 글 목록">
      <div class="blog-main-list">
        {featuredPost && (
          <a class="featured-post-card blog-post-entry" href={`/blog/${featuredPost.slug}/`}>
            <div>
              <span class="category-chip">{featuredPost.category}</span>
              <time datetime={new Date(featuredPost.date).toISOString()}>{new Date(featuredPost.date).toLocaleDateString('ko-KR')}</time>
            </div>
            <h2>{featuredPost.title}</h2>
            <p>{featuredPost.description}</p>
            <ul class="post-tags">{featuredPost.tags?.map((tag: string) => <li>{tag}</li>)}</ul>
          </a>
        )}

        <div class="post-list">
          {restPosts.map((post) => (
            <a class="post-list-item blog-post-entry" href={`/blog/${post.slug}/`}>
              <div class="post-list-meta">
                <span>{post.category}</span>
                <time datetime={new Date(post.date).toISOString()}>{new Date(post.date).toLocaleDateString('ko-KR')}</time>
              </div>
              <div>
                <h2>{post.title}</h2>
                <p>{post.description}</p>
                <ul class="post-tags">{post.tags?.map((tag: string) => <li>{tag}</li>)}</ul>
              </div>
            </a>
          ))}
        </div>
        <p style="margin-top:1.5rem">최근 글 {Math.min(LIST_LIMIT, posts.length)}개를 보여줍니다. 이전 글은 오른쪽 카테고리 목록에서 주제별로 볼 수 있습니다.</p>
      </div>

      <aside class="blog-sidebar" aria-label="블로그 분류">
        <div class="sidebar-card">
          <h2>카테고리</h2>
          <ul class="category-list">
            {categories.map((category) => <li><a class="category-filter" href={categoryPath(category)}><span>{category}</span><strong>{posts.filter((post) => post.category === category).length}</strong></a></li>)}
          </ul>
        </div>
        <div class="sidebar-card">
          <h2>자주 쓰는 태그</h2>
          <ul class="tag-cloud">
            {popularTags.map((tag) => <li><a href={tagPath(tag)}>#{tag}</a></li>)}
          </ul>
        </div>
        <div class="sidebar-card">
          <h2>최근 글</h2>
          <ol class="recent-post-list">
            {posts.slice(0, 5).map((post) => <li><a href={`/blog/${post.slug}/`}>{post.title}</a></li>)}
          </ol>
        </div>
      </aside>
    </section>
  </main>
</BaseLayout>
