---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllPosts, categoryPath, ogImageForCategory, DEFAULT_OG } from '../../../utils/blog';
import {
  CANONICAL_CATEGORIES,
  CATEGORY_INDEX_MIN_POSTS,
  LEGACY_COMPAT_ENTRIES,
  hubForCategory,
  canonicalCategoryFor,
} from '../../../config/taxonomy';

// 글에 등장하는 정식 카테고리마다 아카이브 페이지를 만들고,
// 통합되기 전의 레거시 카테고리 슬러그마다 크롤 안전한 호환 페이지를 만든다.
// 호환 페이지는 noindex, follow 이며 canonical 이 정식 아카이브를 가리켜, 과거에 크롤되었을 수도
// 있는 경로(/blog/category/<레거시 슬러그>/)가 깨지지 않고 정식 카테고리로 안내되게 한다.
export function getStaticPaths() {
  const posts = getAllPosts();

  const canonicalPaths = CANONICAL_CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: {
      mode: 'canonical' as const,
      category: category.name,
      description: category.description,
      posts: posts.filter((post) => canonicalCategoryFor(post.category) === category.name),
    },
  }));

  const legacyPaths = LEGACY_COMPAT_ENTRIES.map((entry) => ({
    params: { category: entry.legacySlug },
    props: {
      mode: 'legacy' as const,
      legacyLabel: entry.legacyLabel,
      category: entry.canonical.name,
      posts: posts.filter((post) => canonicalCategoryFor(post.category) === entry.canonical.name),
    },
  }));

  return [...canonicalPaths, ...legacyPaths];
}

const { mode, category, posts } = Astro.props;
const site = Astro.site ?? new URL('https://perust.github.io');
// 정식 카테고리 아카이브의 경로/URL. 레거시(호환) 페이지도 이 URL을 canonical 로 가리킨다.
const canonicalArchivePath = categoryPath(category);
const canonicalArchiveUrl = new URL(canonicalArchivePath, site).toString();
const hub = hubForCategory(category);

const isLegacy = mode === 'legacy';
const legacyLabel: string | undefined = Astro.props.legacyLabel;
const path = canonicalArchivePath;

const title = isLegacy
  ? `[통합됨] ${legacyLabel} → ${category} · lentoludens 블로그`
  : `${category} 글 모음 · lentoludens 블로그`;
const description = isLegacy
  ? `'${legacyLabel}' 카테고리는 콘텐츠 정리에 따라 '${category}' 카테고리로 통합되었습니다. 관련 글은 이 페이지 아래에서 모두 볼 수 있습니다.`
  : `lentoludens 블로그의 ${category} 카테고리 글 ${posts.length}편을 모았습니다. 최신 글부터 차례로 정리했습니다.`;

// 레거시 카테고리는 항상 noindex, follow. 정식 카테고리는 글이 3개 이상 쌓였을 때만 색인을 허용한다.
const robots = isLegacy ? 'noindex, follow' : posts.length >= CATEGORY_INDEX_MIN_POSTS ? 'index, follow' : 'noindex, follow';

// CollectionPage + ItemList JSON-LD. 답변엔진이 "이 카테고리의 글 목록"을 그대로 읽을 수 있게 한다.
const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: isLegacy ? `${legacyLabel} → ${category} · lentoludens 블로그` : `${category} · lentoludens 블로그`,
  description,
  url: canonicalArchiveUrl,
  inLanguage: 'ko-KR',
  isPartOf: { '@type': 'Blog', name: 'lentoludens 블로그', url: new URL('/blog/', site).toString() },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(`/blog/${post.slug}/`, site).toString(),
      name: post.title,
    })),
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: site.toString() },
    { '@type': 'ListItem', position: 2, name: '블로그', item: new URL('/blog/', site).toString() },
    { '@type': 'ListItem', position: 3, name: category, item: canonicalArchiveUrl },
  ],
};
---
<BaseLayout title={title} description={description} canonical={path} robots={robots} jsonLd={[collectionLd, breadcrumbLd]} image={isLegacy ? DEFAULT_OG : ogImageForCategory(category)}>
  <main>
    <section class="section-shell blog-hero blog-hero-compact">
      <p class="section-kicker"><a href="/blog/">블로그</a> · 카테고리</p>
      {isLegacy ? (
        <>
          <h1>{legacyLabel}</h1>
          <p class="hero-description">
            '{legacyLabel}' 카테고리는 콘텐츠 정리에 따라 <a class="text-link" href={canonicalArchivePath}>'{category}' 카테고리</a>로 통합되었습니다.
            관련 글은 아래에서 계속 볼 수 있습니다.
          </p>
        </>
      ) : (
        <>
          <h1>{category}</h1>
          <p class="hero-description">{category} 카테고리로 묶인 글 {posts.length}편입니다. 최신순으로 정리했습니다.</p>
          {hub && <p class="hero-description"><a class="text-link" href={`/blog/topic/${hub.slug}/`}>{hub.title} 주제 허브에서 더 보기 →</a></p>}
        </>
      )}
    </section>

    <section class="section-shell blog-main-list" aria-label={`${category} 글 목록`} style="padding-top:0">
      <div class="post-list">
        {posts.map((post) => (
          <a class="post-list-item" href={`/blog/${post.slug}/`}>
            <div class="post-list-meta">
              <span>{post.category}</span>
              <time datetime={new Date(post.date).toISOString()}>{new Date(post.date).toLocaleDateString('ko-KR')}</time>
            </div>
            <div>
              <h2>{post.title}</h2>
              <p>{post.description}</p>
              <ul class="post-tags">{post.tags?.map((tag: string) => <li>{tag}</li>)}</ul>
            </div>
          </a>
        ))}
      </div>
      <p style="margin-top:1.5rem"><a class="text-link" href="/blog/">← 블로그 전체 글 보기</a></p>
    </section>
  </main>
</BaseLayout>
