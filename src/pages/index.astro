---
import BaseLayout from '../layouts/BaseLayout.astro';
import { tagPath } from '../utils/blog';
import { FEATURED_MAKER_SLUGS, TOPIC_HUBS, canonicalCategoryFor, isIndexableTag } from '../config/taxonomy';

const modules = import.meta.glob('../content/blog/*.md', { eager: true });
const posts = Object.entries(modules)
  .map(([path, post]: [string, any]) => ({
    slug: path.split('/').pop()?.replace('.md', ''),
    ...post.frontmatter,
  }))
  .sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf());

// 직접 경험을 담은 제작기·자동화 기록(src/config/taxonomy.ts 의 큐레이션 SSOT)을 홈 첫 화면에 우선 노출한다.
const bySlug = new Map(posts.map((post) => [post.slug, post]));
const curatedPosts = FEATURED_MAKER_SLUGS.map((slug) => bySlug.get(slug)).filter(Boolean);
const featuredPost = curatedPosts[0] ?? posts[0];
const secondaryPosts = curatedPosts.filter((post) => post.slug !== featuredPost?.slug).slice(0, 5);
const recentPosts = posts.filter((post) => !curatedPosts.some((curated) => curated.slug === post.slug)).slice(0, 4);
// "자주 쓰는 태그"는 색인 판정 SSOT(isIndexableTag)를 통과한 태그만 빈도순으로 보여준다.
// noindex 태그 페이지로 가는 내부 링크를 만들지 않기 위한 필터다.
const tagCounts = new Map<string, number>();
for (const post of posts) for (const tag of post.tags ?? []) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
const tags = Array.from(tagCounts.entries())
  .filter(([tag, count]) => isIndexableTag(tag, count))
  .sort(([tagA, countA], [tagB, countB]) => countB - countA || tagA.localeCompare(tagB, 'ko'))
  .slice(0, 10)
  .map(([tag]) => tag);

const site = Astro.site ?? new URL('https://perust.github.io');
const homeDescription = 'IT, AI, 경제, 재테크, 자기계발처럼 관심 있는 것을 정리하고 직접 만들어보는 lentoludens 블로그.';
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'lentoludens',
  url: site.toString(),
  inLanguage: 'ko-KR',
  description: homeDescription,
  publisher: { '@type': 'Organization', name: 'lentoludens', url: site.toString() },
};
---
<BaseLayout title="lentoludens · IT/AI/경제 블로그" description={homeDescription} jsonLd={websiteLd}>
  <main id="top">
    <section class="hero section-shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">IT · AI · Economy · Self-improvement</p>
        <h1 id="hero-title">IT, AI, 경제 정보<br />그리고 공부하고 작업해본 것들</h1>
        <p class="hero-description">글은 블로그에 모아두고, 작업하는 프로그램과 예전 작업물은 <a class="inline-link" href="/work/">작업</a> 에 쌓아가고 있습니다.</p>
        <div class="hero-actions">
          <a class="button primary" href="#curated-posts">먼저 읽어볼 글</a>
          <a class="button secondary" href="/blog/">전체 글</a>
          <a class="button secondary" href="/work/">작업 보기</a>
        </div>
      </div>
      {featuredPost && (
        <a class="hero-featured-post" href={`/blog/${featuredPost.slug}/`} aria-label={`추천 글 읽기: ${featuredPost.title}`}>
          <span class="status-pill"><span></span> 먼저 읽어볼 글</span>
          <div class="hero-featured-body">
            <span class="category-chip">{featuredPost.category}</span>
            <h2>{featuredPost.title}</h2>
            <p>{featuredPost.description}</p>
            <ul class="post-tags">{featuredPost.tags?.slice(0, 4).map((tag: string) => <li>{tag}</li>)}</ul>
          </div>
        </a>
      )}
    </section>

    <section id="curated-posts" class="section-shell" aria-labelledby="curated-title">
      <div class="section-heading">
        <p class="section-kicker">Editor’s picks</p>
        <h2 id="curated-title">먼저 읽어볼 글</h2>
        <p>직접 경험을 담은 제작기와 회고, 공식 자료를 바탕으로 정리한 실용 글을 먼저 모았습니다.</p>
      </div>
      <div class="blog-grid home-curation-grid">
        {secondaryPosts.map((post) => (
          <a class="post-card" href={`/blog/${post.slug}/`}>
            <div class="post-card-meta"><span class="category-chip">{post.category}</span><time datetime={new Date(post.date).toISOString()}>{new Date(post.date).toLocaleDateString('ko-KR')}</time></div>
            <h2>{post.title}</h2>
            <p>{post.description}</p>
            <ul class="post-tags">{post.tags?.slice(0, 3).map((tag: string) => <li>{tag}</li>)}</ul>
          </a>
        ))}
      </div>
    </section>

    <section class="section-shell split-section" aria-labelledby="themes-title">
      <div>
        <p class="section-kicker">Themes</p>
        <h2 id="themes-title">관심사별로 읽기</h2>
        <p class="theme-note">전체 글을 훑기 전에 관심 있는 주제부터 볼 수 있게 묶어두었습니다.</p>
      </div>
      <div class="focus-grid">
        {TOPIC_HUBS.map((hub) => (
          <a class="focus-card theme-card" href={`/blog/topic/${hub.slug}/`}>
            <span class="card-index">{String(posts.filter((post) => hub.categories.includes(canonicalCategoryFor(post.category))).length).padStart(2, '0')}</span>
            <h3>{hub.title}</h3>
            <p>{hub.tagline}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="section-shell" aria-labelledby="recent-title">
      <div class="section-heading">
        <p class="section-kicker">Recent notes</p>
        <h2 id="recent-title">최근 글</h2>
      </div>
      <div class="post-list home-recent-list">
        {recentPosts.map((post) => (
          <a class="post-list-item" href={`/blog/${post.slug}/`}>
            <div class="post-list-meta">
              <span>{post.category}</span>
              <time datetime={new Date(post.date).toISOString()}>{new Date(post.date).toLocaleDateString('ko-KR')}</time>
            </div>
            <div>
              <h2>{post.title}</h2>
              <p>{post.description}</p>
              <ul class="post-tags">{post.tags?.slice(0, 4).map((tag: string) => <li>{tag}</li>)}</ul>
            </div>
          </a>
        ))}
      </div>
      <div class="home-tag-row" aria-label="자주 쓰는 태그">
        {tags.map((tag) => <a href={tagPath(tag)}>#{tag}</a>)}
      </div>
    </section>
  </main>
</BaseLayout>
